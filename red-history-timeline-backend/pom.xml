<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven项目配置文件
    
    ========== 功能要求 ==========
    1. 定义项目依赖（Spring Boot、MyBatis、MySQL等）
    2. 配置编译和打包参数
    3. 管理项目版本和构建流程
    
    ========== 修改范围限制 ==========
    - 此文件由项目负责人或运维人员维护
    - 禁止随意添加依赖，需团队讨论
    - 禁止修改Spring Boot版本，除非框架升级
    - 如需添加新依赖，需先确认用途和必要性
    - 其他开发者禁止修改此文件，如有需求需提交PR
    
    ========== 接口调用要求 ==========
    - 不涉及接口调用
    - 管理项目依赖和构建配置
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.5</version>
        <relativePath/>
    </parent>

    <groupId>com.redhistory</groupId>
    <artifactId>red-history-timeline-backend</artifactId>
    <version>1.0.0</version>
    <name>Red History Timeline Backend</name>
    <description>红色历史时间轴后端API</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Spring Boot Web - 提供Web MVC功能 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis Spring Boot Starter - 数据访问层 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- MySQL驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Test - 测试框架 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven插件 - 用于打包可执行JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

